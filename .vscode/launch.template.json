{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Win Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/win/debug/__PROJECT_NAME__.exe",
      "cwd": "${workspaceFolder}/build/win/debug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "Build-Win-Debug"
    },
    {
      "name": "Win Clean Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/win/debug/__PROJECT_NAME__.exe",
      "cwd": "${workspaceFolder}/build/win/debug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "Build-Win-Debug-Clean"
    },
    {
      "name": "ICPAK Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/icpak/build/debug/ICPAK.exe",
      "cwd": "${workspaceFolder}/icpak",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb.exe",
      "preLaunchTask": "Build-ICPAK-Debug"
    }
  ]
}